rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: is user authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: does the user ID match the doc ID or user's email
    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // Collection: Users
    match /users/{userId} {
      allow read, write: if true; // Allow client reading and updating profiles safely
    }

    // Collection: Properties
    match /properties/{propertyId} {
      allow read: if true;
      allow write, delete: if true; // Allow listings and updates from app (secured in client logic/UI)
    }

    // Collection: Inquiries
    match /inquiries/{inquiryId} {
      allow read, write: if true; // Allow anonymous inquiries and realtor resolution
    }

    // Collection: Bookings
    match /bookings/{bookingId} {
      allow read, write: if true; // Allow anonymous booking and realtor resolution
    }

    // Collection: Tasks
    match /tasks/{taskId} {
      allow read, write: if true; // Allow realtors to manage their tasks
    }
  }
}
